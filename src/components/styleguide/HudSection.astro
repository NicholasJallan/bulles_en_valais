---
import Switch from './Switch.astro';

const HUD_FONTS = [
  { value: 'grotesk', label: 'Grotesque tabulaire', detail: 'sans police de plus' },
  { value: 'jetbrains', label: 'JetBrains Mono', detail: 'sous-ensemble' },
  { value: 'geist', label: 'Geist Mono', detail: 'sous-ensemble' },
] as const;

const STATES = [
  {
    name: 'En plongée',
    depth: '12,4',
    temperature: '14',
    time: '03:27',
    alarm: undefined,
    dot: [24, 36.8],
  },
  {
    name: 'Palier de sécurité',
    depth: '5,0',
    temperature: '17',
    time: '02:41',
    alarm: 'PALIER 5 m · 02:41',
    dot: [134, 16],
  },
  {
    name: 'Remontée trop rapide',
    depth: '18,6',
    temperature: '9',
    time: '21:05',
    alarm: '▲ LENT',
    dot: [108, 34.8],
  },
] as const;

const DIGITS = ['0123456789', '12,4 m', '03:27', '14 °C'] as const;

const PROFILE = 'M4 6 L30 46 L96 46 L128 16 L140 16 L152 6';
---

<section id="hud" class="hud sg-section" data-tone="deep" aria-labelledby="sg-hud-title">
  <div class="sg-wrap">
    <header class="sg-heading">
      <h2 id="sg-hud-title">
        Le profondimètre, <em>maquette statique</em>
      </h2>
      <p class="sg-note">
        Esprit ordinateur de plongée : grands chiffres, petites étiquettes, aucune fioriture. Sur
        ordinateur, il se tient au bord droit ; sur téléphone, c’est une pastille en bas à gauche.
        Comparez la police des chiffres.
      </p>
      <Switch name="hud" legend="Chiffres" options={HUD_FONTS} value="grotesk" />
    </header>

    <p class="digits-row" aria-hidden="true">
      {DIGITS.map((group) => (
        <span class="digits-group">{group}</span>
      ))}
    </p>

    <ul class="gauges">
      {STATES.map((state) => (
        <li class="gauge-item">
          <p class="sg-note">{state.name}</p>
          <div class="gauge" aria-hidden="true">
            <p class="gauge-label">Profondeur</p>
            <p class="gauge-depth">
              <span class="gauge-digits">{state.depth}</span>
              <span class="gauge-unit">m</span>
            </p>
            <dl class="gauge-rows">
              <div>
                <dt>Temp.</dt>
                <dd>{state.temperature}&nbsp;°C</dd>
              </div>
              <div>
                <dt>Durée</dt>
                <dd>{state.time}</dd>
              </div>
            </dl>
            {state.alarm && <p class="gauge-alarm">{state.alarm}</p>}
            <svg class="gauge-profile" viewBox="0 0 156 52" focusable="false">
              <path d={PROFILE} />
              <circle cx={state.dot[0]} cy={state.dot[1]} r="3.5" />
            </svg>
          </div>
        </li>
      ))}
      <li class="gauge-item">
        <p class="sg-note">Téléphone : pastille</p>
        <div class="pill" aria-hidden="true">
          <span class="pill-depth">12,4&nbsp;m</span>
          <span class="pill-sep"></span>
          <span>14&nbsp;°C</span>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .digits-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9em;
    max-inline-size: none;
    margin-block-end: var(--space-xl);
    font-family: var(--font-hud);
    font-size: var(--step-4);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .digits-group {
    white-space: nowrap;
  }

  .gauges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
    gap: var(--space-l) var(--grid-gap);
    align-items: start;
    padding: 0;
    list-style: none;
  }

  .gauge-item {
    display: grid;
    gap: var(--space-2xs);
  }

  .gauge {
    display: grid;
    gap: var(--space-2xs);
    inline-size: min(100%, 13.5rem);
    padding: var(--space-s);
    border: 1px solid var(--line);
    border-radius: var(--radius-soft);
    background-color: color-mix(in oklch, var(--bg-panel) 88%, transparent);
    box-shadow: var(--shadow-depth);
    font-variant-numeric: tabular-nums;
  }

  .gauge-label,
  .gauge-rows dt {
    font-size: var(--step--2);
    color: var(--fg-soft);
  }

  .gauge-depth {
    display: flex;
    align-items: baseline;
    gap: 0.25em;
  }

  .gauge-digits {
    font-family: var(--font-hud);
    font-size: 3.25rem;
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .gauge-unit {
    font-size: var(--step--1);
    color: var(--fg-soft);
  }

  .gauge-rows {
    display: grid;
    gap: 0.2em;
    padding-block: var(--space-2xs);
    border-block: 1px solid var(--line-faint);
  }

  .gauge-rows div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .gauge-rows dd {
    font-family: var(--font-hud);
    font-size: var(--step-0);
  }

  .gauge-alarm {
    justify-self: start;
    padding: 0.2em 0.55em;
    border: 1px solid var(--alert);
    border-radius: var(--radius-sharp);
    color: var(--alert);
    font-family: var(--font-hud);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .gauge-profile {
    inline-size: 100%;
    block-size: auto;
    fill: none;
  }

  .gauge-profile path {
    stroke: var(--fg-soft);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  .gauge-profile circle {
    fill: var(--action);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    justify-self: start;
    padding: 0.55em 1em;
    border: 1px solid var(--line);
    border-radius: var(--radius-round);
    background-color: var(--bg-panel);
    box-shadow: var(--shadow-drift);
    font-family: var(--font-hud);
    font-variant-numeric: tabular-nums;
  }

  .pill-depth {
    font-weight: 600;
  }

  .pill-sep {
    inline-size: 1px;
    block-size: 1em;
    background-color: var(--line);
  }
</style>
