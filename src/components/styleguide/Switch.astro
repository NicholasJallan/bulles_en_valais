---
/** Segmented radio group that sets `data-<name>` on <html> (styleguide-switch controller). */
interface Option {
  readonly value: string;
  readonly label: string;
  readonly detail?: string;
}

interface Props {
  name: 'tempo';
  legend: string;
  options: readonly Option[];
  value: string;
  class?: string;
}

const { name, legend, options, value, class: className } = Astro.props;
---

<fieldset class:list={['switch', className]} data-controller="styleguide-switch" data-switch={name}>
  <legend class="switch-legend">{legend}</legend>
  <div class="switch-options">
    {options.map((option) => (
      <label class="switch-option">
        <input type="radio" name={name} value={option.value} checked={option.value === value} />
        <span class="switch-label">{option.label}</span>
        {option.detail && <span class="switch-detail">{option.detail}</span>}
      </label>
    ))}
  </div>
</fieldset>

<style>
  .switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    min-inline-size: 0;
    padding: 0;
    border: 0;
  }

  .switch-legend {
    float: left; /* puts the legend inside the flex row */
    margin-inline-end: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--fg-soft);
  }

  .switch-options {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sharp);
    background-color: var(--bg-panel);
  }

  .switch-option {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: var(--tap-min);
    padding: 0.65em 0.9em;
    border-radius: var(--radius-sharp);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.3;
    cursor: pointer;
  }

  .switch-option input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  @media (hover: hover) {
    .switch-option:hover {
      color: var(--action-text);
    }
  }

  .switch-option:has(input:checked) {
    background-color: var(--action);
    color: var(--action-ink);
  }

  .switch-option:has(input:focus-visible) {
    outline: var(--focus-width) solid var(--action);
    outline-offset: 2px;
    box-shadow: var(--focus-halo);
  }

  .switch-detail {
    font-weight: 400;
  }

  @media (width < 40rem) {
    .switch-detail {
      display: none;
    }
  }
</style>
