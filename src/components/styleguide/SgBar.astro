---
/** Bar of the styleguide: its name and the fonts chosen at Gate 1. */
---

<header class="bar" data-tone="surface">
  <div class="sg-wrap bar-inner">
    <h1 class="bar-title">
      La Descente <span class="bar-sub">système de design</span>
    </h1>
    <p class="bar-fonts">Instrument Serif + Switzer</p>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-nav);
    border-block-end: 1px solid var(--line-faint);
    box-shadow: var(--shadow-float);
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-3xs);
  }

  .bar-title {
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    line-height: 1.1;
  }

  .bar-sub {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0;
    color: var(--fg-soft);
  }

  .bar-fonts {
    padding-block: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--fg-soft);
  }

  @media (width < 48rem) {
    .bar-sub {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
