---
import EmphasisText from '@/components/ui/EmphasisText.astro';
import { QUOTES } from './samples.ts';

const NO_BREAK_SPACE = String.fromCharCode(0xa0);
const kb = (size: number): string => `${size}${NO_BREAK_SPACE}Ko`;

const NOTES = [
  {
    title: 'Polices',
    text: 'Toutes auto-hébergées (Fonts API d’Astro). Google : OFL 1.1. Fontshare : ITF Free Font License 2.0, qui autorise l’auto-hébergement mais interdit le sous-ensemble et la conversion de format. Après la Gate 1, seules la paire choisie et le mono éventuel restent dans la configuration.',
  },
  {
    title: 'Poids',
    text: `Polices préchargées (Gate 1) : Instrument Serif romain ${kb(15)}, italique ${kb(15)}, Switzer romain ${kb(42)}, soit ${kb(72)} pour 3 fichiers (budget : ${kb(150)}).`,
  },
  {
    title: 'Provisoire',
    text: 'Textes repris du site actuel (S03 les réécrit), températures I-05 à valider, HUD et bulles en maquette (S06, S08).',
  },
] as const;
---

<footer class="sg-footer sg-section" data-tone="surface">
  <div class="sg-wrap footer-grid">
    <p class="display footer-quote">
      <EmphasisText value={QUOTES.surface} />
    </p>
    <dl class="footer-notes">
      {NOTES.map((note) => (
        <div>
          <dt>{note.title}</dt>
          <dd class="sg-note">{note.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    gap: var(--space-2xl) var(--grid-gap);
  }

  .footer-quote {
    font-size: var(--step-5);
    line-height: 1.04;
  }

  .footer-notes {
    display: grid;
    gap: var(--space-m);
  }

  .footer-notes dt {
    font-weight: var(--text-strong);
    margin-block-end: var(--space-3xs);
  }

  @media (width >= 64rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
  }
</style>
