---
import portraitWide from '@/assets/images/instructor/nicholas-4x5.jpg';
import portraitSquare from '@/assets/images/instructor/nicholas-1x1.jpg';
import ArtPicture from '@/components/ui/ArtPicture.astro';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { CREDENTIALS } from '@/data/credentials.ts';
import { markerDepth } from '@/data/sections.ts';
import { getDictionary } from '@/i18n/index.ts';
import type { Locale } from '@/i18n/types.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const t = dictionary.instructor;
const credentials = CREDENTIALS.map((credential) => ({
  ...credential,
  verifyUrl: 'verifyUrl' in credential ? credential.verifyUrl : undefined,
}));
---

<Section id="about" tone="surface" class="instructor">
  <div class="wrap split">
    <div class="instructor-intro">
      <SectionHeader
        id="about-title"
        depth={markerDepth('about')}
        eyebrow={t.eyebrow}
        title={t.title}
        lead={t.lead}
      />
      {/* Portrait in 4:5 from 48 rem, square on phones (art direction). */}
      <ArtPicture
        sources={[{ media: '(width >= 48rem)', src: portraitWide, widths: [480, 720, 960, 1280] }]}
        fallback={{ src: portraitSquare, widths: [360, 540, 720, 840, 1080] }}
        sizes="(width >= 64rem) 36vw, (width >= 48rem) 70vw, 100vw"
        alt={t.portraitAlt}
        class="instructor-portrait"
        reveal
      />
    </div>
    <div class="instructor-body">
      {t.body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <h3 class="instructor-credentials-title">{t.credentialsTitle}</h3>
      <dl class="credentials" data-reveal="stagger">
        {credentials.map((credential) => (
          <div class="credential">
            <dt>{credential.issuer}</dt>
            <dd class="tabular">
              {credential.verifyUrl === undefined ? (
                credential.detail
              ) : (
                <a href={credential.verifyUrl} target="_blank" rel="noopener noreferrer">
                  {credential.detail}
                  <span class="visually-hidden">
                    {' '}
                    — {t.verifyCredential} {dictionary.a11y.newTab}
                  </span>
                  <Icon name="arrow-up-right" />
                </a>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</Section>

<style>
  .instructor {
    padding-block-start: 0;
  }

  .instructor-intro {
    display: grid;
    gap: var(--space-xl);
  }

  .instructor :global(.instructor-portrait img) {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-soft);
    box-shadow: var(--shadow-depth);
  }

  @media (width >= 48rem) {
    .instructor :global(.instructor-portrait img) {
      aspect-ratio: 4 / 5;
      max-inline-size: 30rem;
    }
  }

  .instructor-body {
    display: grid;
    gap: var(--space-s);
  }

  /* On wide screens the text starts level with the lead, the portrait hangs lower on the left. */
  @media (width >= 64rem) {
    .instructor-body {
      padding-block-start: var(--space-3xl);
    }
  }

  .instructor-credentials-title {
    margin-block-start: var(--space-l);
    font-size: var(--step-2);
  }

  .credentials {
    display: grid;
    border-block-start: 1px solid var(--line);
  }

  .credential {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--line);
  }

  .credential dt {
    font-weight: var(--text-strong);
  }

  .credential dd {
    color: var(--fg-soft);
  }

  .credential a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-block-size: var(--tap-min);
  }
</style>
