---
import EmphasisText from '@/components/ui/EmphasisText.astro';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { EMAIL, PHONE, whatsappUrl } from '@/data/contact.ts';
import { CREDENTIALS } from '@/data/credentials.ts';
import { markerDepth } from '@/data/sections.ts';
import { getDictionary } from '@/i18n/index.ts';
import type { Locale } from '@/i18n/types.ts';
import ContactForm from './ContactForm.astro';

/**
 * Back at the surface (E14): under a Snell's window — the disc of sky seen from below the surface,
 * soft light behind the title — the direct channels first, then the form. With motion, snell.ts
 * opens the window as the section comes up, and its shimmer drifts with the scroll.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const t = dictionary.contact;
const channels = [
  {
    label: t.channels.whatsapp,
    value: PHONE.display,
    href: whatsappUrl(dictionary.whatsapp.defaultMessage),
    icon: 'message',
    external: true,
  },
  {
    label: t.channels.phone,
    value: PHONE.display,
    href: PHONE.href,
    icon: 'phone',
    external: false,
  },
  { label: t.channels.email, value: EMAIL, href: `mailto:${EMAIL}`, icon: 'mail', external: false },
] as const;
---

<Section id="contact" tone="surface" class="contact">
  <div class="snell" aria-hidden="true" data-snell>
    <div class="snell-disc" data-snell-disc>
      <div class="snell-shimmer" data-snell-shimmer></div>
    </div>
  </div>
  <div class="wrap contact-inner">
    <SectionHeader
      id="contact-title"
      depth={markerDepth('contact')}
      eyebrow={t.eyebrow}
      title={t.title}
      class="contact-head"
    />
    <div class="split">
      <div class="contact-direct">
        <h3 class="contact-subtitle">
          <EmphasisText value={t.subtitle} />
        </h3>
        <p>{t.lead}</p>
        <ul class="bare-list contact-channels">
          {channels.map((channel) => (
            <li>
              <a
                class="contact-channel"
                href={channel.href}
                target={channel.external ? '_blank' : undefined}
                rel={channel.external ? 'noopener noreferrer' : undefined}
              >
                <Icon name={channel.icon} class="contact-channel-icon" />
                <span class="contact-channel-label">{channel.label}</span>
                <span class="contact-channel-value tabular">{channel.value}</span>
                {channel.external && <span class="visually-hidden">{dictionary.a11y.newTab}</span>}
              </a>
            </li>
          ))}
        </ul>
        <div class="contact-credentials">
          <h3 class="fine">{t.credentialsTitle}</h3>
          <p class="fine">
            {CREDENTIALS.map((credential) => `${credential.issuer} ${credential.detail}`).join(
              ' · ',
            )}
          </p>
        </div>
      </div>
      <ContactForm locale={locale} />
    </div>
  </div>
</Section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  /* Snell's window: a disc of light above the title, brighter than the water around it. */
  .snell {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    --snell-size: min(150vw, 72rem);
    display: grid;
    justify-items: center;
    pointer-events: none;
    /* No hard edge where the section starts: the light fades in from the water above. */
    mask-image: linear-gradient(transparent, var(--fg) var(--space-section));
  }

  @media (width >= 64rem) {
    .snell {
      justify-items: start;
    }

    .snell-disc {
      margin-inline-start: calc(28% - var(--snell-size) / 2);
    }
  }

  .snell-disc {
    position: relative;
    inline-size: var(--snell-size);
    aspect-ratio: 1;
    margin-block-start: calc(-0.42 * var(--snell-size));
    border-radius: var(--radius-round);
    /* Seen from below, the window is ringed by darker water (the light beyond 48.6° is
       reflected back down). */
    background: radial-gradient(
      closest-side,
      var(--c-surface-raised) 0 50%,
      color-mix(in oklch, var(--c-surface-raised) 60%, transparent) 62%,
      color-mix(in oklch, var(--c-lagoon) 70%, transparent) 74%,
      color-mix(in oklch, var(--c-lagoon) 30%, transparent) 86%,
      transparent
    );
    overflow: hidden;
  }

  /* The surface ripples in the window: the shimmer of the thermoclines, inside the disc only. */
  .snell-shimmer {
    position: absolute;
    inset: -20%;
    background-image: url('@/assets/textures/shimmer.svg');
    background-size: 40rem 14rem;
    opacity: 0.12;
    mask-image: radial-gradient(closest-side, var(--fg) 30%, transparent 70%);
  }

  .contact-inner {
    display: grid;
    gap: var(--space-2xl);
  }

  .contact :global(.contact-head .section-title) {
    font-size: var(--step-5);
    max-inline-size: 18ch;
  }

  .contact-direct {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .contact-subtitle {
    font-size: var(--step-3);
  }

  .contact-channels {
    display: grid;
    border-block-start: 1px solid var(--line);
  }

  .contact-channel {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'icon label' 'icon value';
    column-gap: var(--space-s);
    align-items: center;
    padding-block: var(--space-s);
    border-block-end: 1px solid var(--line);
    color: var(--fg);
    text-decoration: none;
  }

  .contact-channel :global(.contact-channel-icon) {
    grid-area: icon;
    inline-size: 1.5em;
    block-size: 1.5em;
    color: var(--action-text);
  }

  .contact-channel-label {
    grid-area: label;
    font-size: var(--step--1);
    color: var(--fg-soft);
  }

  .contact-channel-value {
    grid-area: value;
    font-size: var(--step-1);
    font-weight: var(--text-strong);
    overflow-wrap: anywhere;
  }

  .contact-channel :global(.contact-channel-icon) {
    transition: transform var(--dur-fast) var(--ease-buoyant);
  }

  /* Hover lights the value like the lamp, and the icon rises towards the surface (transform
     only: nothing moves in the layout). */
  @media (hover: hover) {
    .contact-channel:hover .contact-channel-value {
      color: var(--action-text);
    }

    .contact-channel:hover :global(.contact-channel-icon) {
      transform: translateY(-3px) scale(1.12);
    }
  }

  .contact-channel:focus-visible :global(.contact-channel-icon) {
    transform: translateY(-3px) scale(1.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-channel :global(.contact-channel-icon) {
      transition: none;
    }
  }

  .contact-credentials h3 {
    font-family: var(--font-sans);
    font-weight: var(--text-strong);
  }
</style>
