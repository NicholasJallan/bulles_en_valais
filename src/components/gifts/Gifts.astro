---
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { courseById, isOnRequest } from '@/data/courses.ts';
import { GIFT_OFFERS } from '@/data/gifts.ts';
import { markerDepth } from '@/data/sections.ts';
import { getDictionary } from '@/i18n/index.ts';
import type { Locale } from '@/i18n/types.ts';
import { formatCHF } from '@/lib/format.ts';
import GiftCard from './GiftCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).gifts;
const offers = GIFT_OFFERS.map((offer) => {
  const price = 'course' in offer ? courseById(offer.course).price : undefined;
  return {
    ...t.offers[offer.id],
    price: price && !isOnRequest(price) ? formatCHF(price.amount, locale) : undefined,
  };
});
---

<Section id="gifts" tone="lagoon" class="gifts">
  <div class="wrap gifts-inner">
    <div class="split gifts-head">
      <SectionHeader
        id="gifts-title"
        depth={markerDepth('gifts')}
        eyebrow={t.eyebrow}
        title={t.title}
        lead={t.lead}
      />
      <GiftCard locale={locale} />
    </div>

    <div class="gifts-details">
      <div>
        <h3 class="gifts-subtitle">{t.offersTitle}</h3>
        <ul class="bare-list gifts-offers">
          {offers.map((offer) => (
            <li>
              <h4>{offer.title}</h4>
              <p>{offer.text}</p>
              {offer.price && <p class="gifts-price tabular">{offer.price}</p>}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="gifts-subtitle">{t.stepsTitle}</h3>
        <ol class="bare-list gifts-steps">
          {t.steps.map((step) => (
            <li>
              <h4>{step.title}</h4>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h3 class="gifts-subtitle">{t.conditionsTitle}</h3>
        <ul class="gifts-conditions">
          {t.conditions.map((condition) => (
            <li>{condition}</li>
          ))}
        </ul>
        <Button href="#contact-form" icon="arrow-down" data-prefill-interest="gift">
          {t.cta}
        </Button>
      </div>
    </div>
  </div>
</Section>

<style>
  .gifts-inner {
    display: grid;
    gap: var(--space-2xl);
  }

  .gifts-head {
    align-items: center;
  }

  .gifts-details {
    display: grid;
    gap: var(--space-xl) var(--grid-gap);
  }

  @media (width >= 64rem) {
    .gifts-details {
      grid-template-columns: 4fr 4fr 3fr;
    }
  }

  .gifts-subtitle {
    margin-block-end: var(--space-s);
    padding-block-end: var(--space-2xs);
    border-block-end: 1px solid var(--line);
    font-size: var(--step-2);
  }

  .gifts-offers,
  .gifts-steps {
    display: grid;
    gap: var(--space-m);
  }

  .gifts-offers h4,
  .gifts-steps h4 {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: var(--text-strong);
  }

  .gifts-offers p,
  .gifts-steps p {
    color: var(--fg-soft);
  }

  .gifts-price {
    margin-block-start: var(--space-3xs);
    font-size: var(--step-1);
    color: var(--fg);
  }

  /* A real sequence: the steps are counted. */
  .gifts-steps {
    counter-reset: step;
  }

  .gifts-steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: var(--space-2xs);
  }

  .gifts-steps li::before {
    content: counter(step);
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--fg-soft);
  }

  .gifts-conditions {
    display: grid;
    gap: var(--space-2xs);
    margin-block-end: var(--space-l);
    padding-inline-start: 1.1em;
    color: var(--fg-soft);
  }
</style>
