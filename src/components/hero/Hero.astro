---
import { Picture } from 'astro:assets';
import heroImage from '@/assets/images/hero/rosel.jpg';
import Button from '@/components/ui/Button.astro';
import EmphasisText from '@/components/ui/EmphasisText.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import { CREDENTIALS } from '@/data/credentials.ts';
import { PLACES } from '@/data/places.ts';
import { markerDepth } from '@/data/sections.ts';
import { getDictionary } from '@/i18n/index.ts';
import type { Locale } from '@/i18n/types.ts';
import { formatCoordinates } from '@/lib/format.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
// The photo is the Rosel: its coordinates sign the image.
const rosel = PLACES.find((place) => place.id === 'rosel');
if (rosel === undefined) throw new Error('The Rosel is missing from places.ts');
const teaching = CREDENTIALS.filter((credential) =>
  ['sdi-tdi', 'padi', 'ffessm'].includes(credential.id),
);
---

<Section id="top" tone="deep" class="hero">
  {/* The LCP element: never hidden, never waiting for WebGL (S07 lays the water over it). */}
  <Picture
    src={heroImage}
    alt={t.hero.imageAlt}
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1600, 1920, 2560]}
    sizes="100vw"
    quality={60}
    loading="eager"
    fetchpriority="high"
    class="hero-image"
  />
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="wrap hero-content">
    <Eyebrow depth={markerDepth('top')} label={t.hero.eyebrow} />
    <h1 id="top-title" class="hero-title">
      <EmphasisText value={t.hero.title} />
    </h1>
    <p class="lead hero-lead">{t.hero.lead}</p>
    <div class="hero-actions">
      <Button href="#contact" icon="arrow-down">
        {t.hero.primaryCta}
      </Button>
      <Button href="#agencies" variant="secondary">
        {t.hero.secondaryCta}
      </Button>
    </div>
  </div>
  <div class="wrap hero-meta fine">
    <ul class="bare-list hero-credentials">
      {teaching.map((credential) => (
        <li>
          {credential.issuer} {credential.detail}
        </li>
      ))}
    </ul>
    <p class="hero-places">
      <span>{t.hero.places}</span>
      <span class="tabular">{formatCoordinates(rosel.coords, locale)}</span>
    </p>
  </div>
</Section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: end;
    gap: var(--space-l);
    min-block-size: 100svh;
    padding-block: calc(var(--space-section) + var(--space-xl)) var(--space-m);
    isolation: isolate;
    overflow: hidden;
  }

  .hero :global(.hero-image) {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }

  /* Dark water rising from the bottom carries the text; a lighter veil at the top, the masthead. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        oklch(14% 0.03 245 / 0.92) 0%,
        oklch(14% 0.03 245 / 0.78) 38%,
        oklch(14% 0.03 245 / 0.2) 72%,
        oklch(14% 0.03 245 / 0) 85%
      ),
      linear-gradient(to bottom, oklch(14% 0.03 245 / 0.55), oklch(14% 0.03 245 / 0) 22%);
  }

  .hero-content {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .hero-title {
    max-inline-size: 11ch;
    margin-block: var(--space-2xs) 0;
  }

  /* On the photo the decorative light stays warm, like the sun on the lake. */
  .hero-title :global(em) {
    color: var(--c-deco-emerald);
  }

  .hero-lead {
    max-inline-size: 42ch;
    color: var(--fg-soft);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-2xs);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-l);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--line);
    color: var(--fg-soft);
  }

  .hero-credentials,
  .hero-places {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
  }

  .hero-places {
    max-inline-size: none;
  }
</style>
