---
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import TabList from '@/components/ui/TabList.astro';
import { markerDepth } from '@/data/sections.ts';
import { SPECIALTIES, SPECIALTY_TABS } from '@/data/specialties.ts';
import { getDictionary } from '@/i18n/index.ts';
import type { Locale } from '@/i18n/types.ts';
import SpecialtyCard from './SpecialtyCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).specialties;
const tabs = SPECIALTY_TABS.map((tab) => ({
  id: `specialties-${tab}-tab`,
  panelId: `specialties-${tab}`,
  label: t.tabs[tab].label,
}));
---

<Section id="specialties" tone="abyss" class="specialties">
  <div class="wrap specialties-inner" data-controller="tabs">
    <SectionHeader
      id="specialties-title"
      depth={markerDepth('specialties')}
      eyebrow={t.eyebrow}
      title={t.title}
      lead={t.lead}
    />
    <TabList label={t.tabsLabel} tabs={tabs} />
    <div>
      {SPECIALTY_TABS.map((tab, index) => (
        <div
          id={`specialties-${tab}`}
          class="specialty-panel"
          data-tab-panel
          data-active={index === 0 ? '' : undefined}
        >
          <div class="specialty-panel-head">
            <h3 data-tab-headline>{t.tabs[tab].label}</h3>
            <p>{t.tabs[tab].lead}</p>
          </div>
          <ul class="bare-list specialty-list">
            {SPECIALTIES[tab].map((card) => (
              <SpecialtyCard locale={locale} card={card} />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</Section>

<style>
  .specialties-inner {
    display: grid;
    gap: var(--space-xl);
  }

  /* ——— The lamp (torch.ts, E8): under the content, it only adds light. ——— */
  .specialties[data-torch] {
    --torch-size: clamp(18rem, 12rem + 24vw, 34rem);

    position: relative;
    isolation: isolate;
  }

  .specialties[data-torch] .specialties-inner {
    position: relative;
    z-index: var(--z-raised);
  }

  /* In the dark the cards are dimmed (--torch-dim, below AA on purpose: D44; full contrast without
     motion); the beam brings them back to full light and warms their title. Only opacity moves. */
  .specialties[data-torch] :global(.specialty > *) {
    opacity: var(--torch-dim);
    transition: opacity var(--dur-base) var(--ease-surface);
  }

  .specialties[data-torch] :global(.specialty.is-lit > *) {
    opacity: 1;
  }

  .specialties[data-torch] :global(.specialty.is-lit .specialty-title) {
    color: var(--c-torch-pale);
  }

  /* Cut at the sides only: at the top and bottom edges the light spills over the picture above
     and the water below instead of stopping at a straight line. */
  .specialties :global(.torch) {
    position: absolute;
    inset: 0;
    overflow: clip visible;
    pointer-events: none;
  }

  .specialties :global(.torch-beam) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: var(--torch-size);
    aspect-ratio: 1;
    overflow: clip;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklch, var(--c-torch-glow) 20%, transparent),
      color-mix(in oklch, var(--c-torch-glow) 7%, transparent) 55%,
      transparent
    );
    mask-image: radial-gradient(closest-side, var(--fg) 30%, transparent);
    will-change: transform;
  }

  /* The motes of the whole section, held still while the beam moves over them. */
  .specialties :global(.torch-motes) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    /* Wider than the beam: not the max-inline-size of the reset. */
    max-inline-size: none;
    opacity: 0.55;
    will-change: transform;
  }

  .specialty-panel {
    display: grid;
    gap: var(--space-l);
  }

  .specialty-panel + .specialty-panel {
    margin-block-start: var(--space-2xl);
  }

  .specialty-panel-head {
    display: grid;
    gap: var(--space-xs);
    max-inline-size: 60ch;
    color: var(--fg-soft);
  }

  .specialty-panel-head h3 {
    color: var(--fg);
  }

  /* Two columns of an index, not a grid of boxes: the abyss is bare. */
  .specialty-list {
    display: grid;
    column-gap: var(--grid-gap);
  }

  @media (width >= 64rem) {
    .specialty-list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
