---
import type { Tone } from '@/lib/color/palette.ts';
import { toneWater } from './water-tones.ts';

/**
 * Thermocline (E4) between two sections of different tones: a band without text. Static, a
 * gradient from one water to the other; with the motion module, a window onto the water column
 * whose layers fade as the band goes by, under a shimmer moved with transform.
 */
interface Props {
  from: Tone;
  to: Tone;
  /** A depth marker written in the band, like on a descent line (« Remontée · 40 m »). */
  label?: string;
}

const { from, to, label } = Astro.props;
---

<div
  class="thermocline"
  aria-hidden="true"
  data-thermocline
  data-from={from}
  data-to={to}
  style={`--from: ${toneWater(from)}; --to: ${toneWater(to)}`}
>
  <div class="thermocline-shimmer" data-thermocline-shimmer></div>
  {label && <p class="thermocline-label wrap fine">{label}</p>}
</div>

<style>
  .thermocline {
    position: relative;
    block-size: clamp(25svh, 10rem + 12svh, 40svh);
    overflow: hidden;
    background-image: linear-gradient(var(--from), var(--to));
  }

  /* With the motion module, the middle of the band shows the fixed water column. */
  :global(html.motion-ready) .thermocline {
    background-image: linear-gradient(var(--from), transparent 35%, transparent 65%, var(--to));
  }

  .thermocline-label {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-s);
    block-size: 100%;
    max-inline-size: none;
    color: var(--c-foam-soft);
    letter-spacing: var(--tracking-label);
  }

  .thermocline-label::before {
    content: '';
    inline-size: var(--space-l);
    block-size: 1px;
    background-color: currentcolor;
  }

  .thermocline-shimmer {
    position: absolute;
    inset: -30% 0;
    background-image: url('@/assets/textures/shimmer.svg');
    background-size: 60rem 20rem;
    opacity: 0.07;
  }
</style>
