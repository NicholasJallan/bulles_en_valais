---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/ui/Icon.astro';
import { mapUrl, type Place } from '@/data/places.ts';
import { getDictionary, localize } from '@/i18n/index.ts';
import type { Locale } from '@/i18n/types.ts';
import { formatCoordinates, formatDepth } from '@/lib/format.ts';

interface Props {
  locale: Locale;
  place: Place;
}

const { locale, place } = Astro.props;
const t = getDictionary(locale).places;
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/places/*.jpg', {
  eager: true,
});
const photo = photos[`/src/assets/images/${place.photo.file}`]?.default;
if (photo === undefined) throw new Error(`Missing photo ${place.photo.file}`);
---

<li class="place" data-places-panel data-place={place.id}>
  <Picture
    src={photo}
    alt={localize(place.photo.alt, locale)}
    formats={['avif', 'webp']}
    widths={[400, 600, 800, 1200]}
    sizes="(width >= 64rem) 30vw, (width >= 40rem) 60vw, 100vw"
    class="place-photo"
    pictureAttributes={{ 'data-reveal': 'image' }}
  />
  <div class="place-text">
    <h3 class="place-name">{localize(place.name, locale)}</h3>
    <p class="place-area">
      {localize(place.area, locale)} ·{' '}
      <a class="place-map-link" href={mapUrl(place.coords)}>
        <span class="tabular">{formatCoordinates(place.coords, locale)}</span>
        <span class="visually-hidden">, {t.openMap}</span>
        <Icon name="arrow-up-right" />
      </a>
    </p>
    <p>{localize(place.description, locale)}</p>
    <dl class="place-facts">
      <div>
        <dt>{t.facts.maxDepth}</dt>
        <dd class="tabular">{formatDepth(place.facts.maxDepth, locale)}</dd>
      </div>
      {place.facts.sites && (
        <div>
          <dt>{t.facts.sites}</dt>
          <dd>{place.facts.sites.map((site) => localize(site, locale)).join(' · ')}</dd>
        </div>
      )}
    </dl>
  </div>
</li>

<style>
  .place {
    /* Holds the visually hidden text of its link inside the scrolling row (narrow screens). */
    position: relative;
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .place :global(.place-photo) {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-soft);
    box-shadow: var(--shadow-depth);
  }

  .place-text {
    display: grid;
    gap: var(--space-xs);
  }

  .place-name {
    font-size: var(--step-3);
  }

  .place-area {
    font-size: var(--step--1);
    color: var(--fg-soft);
  }

  .place-map-link {
    white-space: nowrap;
  }

  .place-map-link :global(.icon) {
    display: inline-block;
    margin-inline-start: 0.1em;
    vertical-align: -0.25em;
  }

  .place-facts {
    display: grid;
    gap: var(--space-2xs);
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .place-facts div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
  }

  .place-facts dt {
    font-weight: var(--text-strong);
  }

  .place-facts dd {
    color: var(--fg-soft);
  }
</style>
