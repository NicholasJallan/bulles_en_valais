---
import { DIVE_PROFILE, type SectionId } from '@/data/sections.ts';

export type Tone = 'surface' | 'lagoon' | 'emerald' | 'deep' | 'abyss';

/**
 * A section of the dive profile: its anchor, its water (data-tone) and the depths the HUD runs
 * through (S06). Labelled by its h2, whose id is `<id>-title`.
 */
interface Props {
  id: SectionId;
  tone: Tone;
  class?: string;
  /** Scope attribute of the parent's styles (data-astro-cid-*), forwarded as is. */
  [attribute: `data-${string}`]: unknown;
}

const { id, tone, class: className, ...attributes } = Astro.props;
const profile = DIVE_PROFILE.find((section) => section.id === id);
if (profile === undefined) throw new Error(`Section "${id}" is not in the dive profile`);
const { hud } = profile;
---

<section
  id={id}
  class:list={['section', className]}
  aria-labelledby={`${id}-title`}
  data-tone={tone}
  data-depth-start={hud?.start}
  data-depth-end={hud?.end}
  data-hud={hud === null ? 'hidden' : undefined}
  {...attributes}
>
  <slot />
</section>
