---
// Styleguide of « La Descente » for Gate 1 (S02): noindex, out of the sitemap, removed in S13.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComponentsSection from '@/components/styleguide/ComponentsSection.astro';
import HeroSpecimen from '@/components/styleguide/HeroSpecimen.astro';
import HudSection from '@/components/styleguide/HudSection.astro';
import MotionSection from '@/components/styleguide/MotionSection.astro';
import PaletteSection from '@/components/styleguide/PaletteSection.astro';
import SgBar from '@/components/styleguide/SgBar.astro';
import SgFooter from '@/components/styleguide/SgFooter.astro';
import TypeSpecimen from '@/components/styleguide/TypeSpecimen.astro';
import WaterColumn from '@/components/styleguide/WaterColumn.astro';
import '@/components/styleguide/styleguide.css';
---

<BaseLayout
  locale="fr"
  title="Styleguide · La Descente"
  description="Système de design de la refonte « La Descente » : palette, typographie, composants et mouvement."
  noindex
>
  <SgBar />
  <main>
    <HeroSpecimen />
    <TypeSpecimen />
    <PaletteSection />
    <WaterColumn />
    <ComponentsSection />
    <HudSection />
    <MotionSection />
  </main>
  <SgFooter />
</BaseLayout>
