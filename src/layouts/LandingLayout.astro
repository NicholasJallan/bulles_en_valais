---
import Button from '@/components/ui/Button.astro';
import EmphasisText from '@/components/ui/EmphasisText.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactForm from '@/components/contact/ContactForm.astro';
import Footer from '@/components/footer/Footer.astro';
import Nav from '@/components/nav/Nav.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { EMAIL, PHONE, whatsappUrl } from '@/data/contact.ts';
import { courseById, fillPrices, isOnRequest } from '@/data/courses.ts';
import type { LandingPageData } from '@/data/landings.ts';
import { getDictionary, localize } from '@/i18n/index.ts';
import { routePath } from '@/i18n/routes.ts';
import type { Locale, Localized } from '@/i18n/types.ts';
import { buildLandingJsonLd, serializeJsonLd } from '@/lib/seo/jsonld.ts';

interface Props {
  locale: Locale;
  landing: LandingPageData;
}

const { locale, landing } = Astro.props;
const dictionary = getDictionary(locale);
const t = dictionary.landing;
const tContact = dictionary.contact;
/** A text of the landing, typeset, with its `{price:…}` read from courses.ts. */
const text = (value: Localized): string => fillPrices(localize(value, locale), locale);

const title = text(landing.meta.title);
const description = text(landing.meta.description);
const ogTitle = text(landing.meta.ogTitle);
const ogDescription = text(landing.meta.ogDescription);

const siteUrl = Astro.site?.origin ?? 'https://dive.bullesenvalais.ch';
const canonicalUrl = `${siteUrl}${routePath(landing.route, locale)}`;
const homeUrl = `${siteUrl}${routePath('home', locale)}`;

const { price } = courseById(landing.primaryCourseId);
if (isOnRequest(price)) throw new Error(`${landing.primaryCourseId} has no price to offer`);
const jsonLd = serializeJsonLd(
  buildLandingJsonLd({
    site: siteUrl,
    locale,
    url: canonicalUrl,
    name: title,
    description,
    price: price.amount,
    faq: landing.faq.map((item) => ({ question: text(item.question), answer: text(item.answer) })),
    breadcrumbHome: t.breadcrumbHome,
  }),
);
const whatsappHref = whatsappUrl(text(landing.hero.primaryCta));
const contactChannels = [
  {
    label: tContact.channels.whatsapp,
    value: PHONE.display,
    href: whatsappHref,
    icon: 'message',
    external: true,
  },
  {
    label: tContact.channels.phone,
    value: PHONE.display,
    href: PHONE.href,
    icon: 'phone',
    external: false,
  },
  {
    label: tContact.channels.email,
    value: EMAIL,
    href: `mailto:${EMAIL}`,
    icon: 'mail',
    external: false,
  },
] as const;
---

<BaseLayout
  locale={locale}
  route={landing.route}
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
>
  <script type="application/ld+json" is:inline slot="head" set:html={jsonLd} />
  <!-- En-tête avec Navigation -->
  <Nav locale={locale} route={landing.route} />

  <main id="content" class="landing-main">
    <!-- HERO SECTION -->
    <section class="landing-hero" id="top" data-tone="deep">
      <div class="wrap landing-hero-content">
        <span class="eyebrow landing-eyebrow">{text(landing.hero.eyebrow)}</span>
        <h1 class="landing-title">
          <EmphasisText
            value={{
              before: text(landing.hero.title.before),
              em: text(landing.hero.title.em),
              after: text(landing.hero.title.after),
            }}
          />
        </h1>
        <p class="lead landing-lead">{text(landing.hero.lead)}</p>

        <!-- CARTE DES CHIFFRES CLÉS / TARIFS -->
        <div class="landing-facts-grid">
          {landing.facts.map((fact) => (
            <div class="landing-fact-card">
              <span class="landing-fact-label">{text(fact.label)}</span>
              <strong class="landing-fact-value">{text(fact.value)}</strong>
            </div>
          ))}
        </div>

        <div class="landing-hero-actions">
          <Button href="#reserver" icon="arrow-down">
            {text(landing.hero.primaryCta)}
          </Button>
          <Button
            href={whatsappHref}
            variant="secondary"
            icon="message"
            target="_blank"
            rel="noopener noreferrer"
          >
            {text(landing.hero.secondaryCta)}
          </Button>
        </div>
      </div>
    </section>

    <!-- HIGHLIGHTS / POURQUOI CHOISIR BULLES EN VALAIS -->
    <section data-tone="surface" class="landing-highlights-section landing-section">
      <div class="wrap">
        <header class="landing-section-header">
          <span class="eyebrow landing-section-eyebrow">{t.highlightsEyebrow}</span>
          <h2 class="landing-section-title">
            <em>{text(landing.highlightsTitle)}</em>
          </h2>
        </header>
        <div class="landing-cards-grid">
          {landing.highlights.map((item) => (
            <article class="landing-highlight-card">
              <div class="landing-card-icon">
                <Icon name="check" />
              </div>
              <h3 class="landing-card-title">{text(item.title)}</h3>
              <p class="landing-card-text">{text(item.description)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ÉTAPES DE DÉROULEMENT -->
    <section data-tone="lagoon" class="landing-steps-section landing-section">
      <div class="wrap">
        <header class="landing-section-header">
          <span class="eyebrow landing-section-eyebrow">{t.stepsEyebrow}</span>
          <h2 class="landing-section-title">
            <em>{text(landing.stepsTitle)}</em>
          </h2>
          <p class="landing-section-lead">{text(landing.stepsLead)}</p>
        </header>
        <div class="landing-steps-list">
          {landing.steps.map((step) => (
            <div class="landing-step-row">
              <div class="landing-step-num">{step.num}</div>
              <div class="landing-step-body">
                <div class="landing-step-header">
                  <h3 class="landing-step-title">{text(step.title)}</h3>
                  <span class="landing-step-duration">{text(step.duration)}</span>
                </div>
                <p class="landing-step-description">{text(step.description)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ SPÉCIFIQUE -->
    <section data-tone="deep" class="landing-faq-section landing-section">
      <div class="wrap">
        <header class="landing-section-header">
          <span class="eyebrow landing-section-eyebrow">{t.faqEyebrow}</span>
          <h2 class="landing-section-title">
            <em>{text(landing.faqTitle)}</em>
          </h2>
        </header>
        <div class="landing-faq-grid">
          {landing.faq.map((item) => (
            <details class="landing-faq-details">
              <summary class="landing-faq-question">
                <span>{text(item.question)}</span>
                <Icon name="arrow-down" class="landing-faq-arrow" />
              </summary>
              <div class="landing-faq-answer">
                <p>{text(item.answer)}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- RÉSERVATION / FORMULAIRE DE CONTACT -->
    <section id="reserver" data-tone="surface" class="landing-contact-section landing-section">
      <div class="wrap">
        <header class="landing-section-header">
          <span class="eyebrow landing-section-eyebrow">{t.contactEyebrow}</span>
          <h2 class="landing-section-title">
            <EmphasisText value={t.contactTitle} />
          </h2>
          <p class="landing-section-lead">{t.contactLead}</p>
        </header>

        <div class="landing-contact-layout">
          <div class="landing-channels">
            <h3 class="landing-channels-title">{t.channelsTitle}</h3>
            <ul class="bare-list landing-channels-list">
              {contactChannels.map((c) => (
                <li>
                  <a
                    href={c.href}
                    class="landing-channel-link"
                    target={c.external ? '_blank' : undefined}
                    rel={c.external ? 'noopener noreferrer' : undefined}
                  >
                    <Icon name={c.icon} />
                    <div>
                      <div class="landing-channel-label">{c.label}</div>
                      <div class="landing-channel-value">{c.value}</div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="landing-form-box">
            <ContactForm locale={locale} defaultInterest={landing.contactInterest} />
          </div>
        </div>
      </div>
    </section>

    <!-- PASSERELLE VERS LA DESCENTE (LE MONO-PAGE ARTISTIQUE) -->
    <section class="landing-descent-teaser" data-tone="abyss">
      <div class="wrap landing-teaser-inner">
        <span class="eyebrow landing-teaser-eyebrow">{text(landing.descentTeaser.eyebrow)}</span>
        <h2 class="landing-teaser-title">{text(landing.descentTeaser.title)}</h2>
        <p class="landing-teaser-lead">{text(landing.descentTeaser.lead)}</p>
        <Button href={homeUrl} variant="secondary">
          {text(landing.descentTeaser.cta)}
        </Button>
      </div>
    </section>
  </main>

  <Footer locale={locale} route={landing.route} />
</BaseLayout>

<style>
  .landing-main {
    overflow-x: hidden;
  }

  .landing-section {
    padding-block: var(--space-2xl);
    background-color: var(--bg);
    color: var(--fg);
  }

  /* Eyebrows take the site's .eyebrow (typography.css: --fg-soft, AA in every tone), centred. */
  .landing-eyebrow,
  .landing-section-eyebrow,
  .landing-teaser-eyebrow {
    justify-content: center;
    margin-block-end: var(--space-2xs);
  }

  .landing-section-header {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto var(--space-xl);
  }

  .landing-section-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: var(--leading-tight);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
  }

  .landing-section-lead {
    font-size: var(--step-0);
    color: var(--fg-soft);
    margin-block-start: var(--space-xs);
    line-height: var(--leading-lead);
  }

  .landing-hero {
    padding-block: var(--space-3xl) var(--space-2xl);
    background: radial-gradient(circle at 50% 20%, var(--c-deep) 0%, var(--c-abyss) 100%);
    border-block-end: 1px solid var(--line);
    text-align: center;
  }

  .landing-hero-content {
    max-width: 52rem;
    display: grid;
    gap: var(--space-m);
    justify-items: center;
  }

  .landing-title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: var(--leading-tight);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
  }

  .landing-lead {
    font-size: var(--step-1);
    color: var(--fg-soft);
    max-width: 42rem;
    line-height: var(--leading-lead);
  }

  .landing-facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-s);
    width: 100%;
    margin-block: var(--space-m);
  }

  .landing-fact-card {
    background-color: color-mix(in oklch, var(--fg) 5%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-soft);
    padding: var(--space-s) var(--space-m);
    backdrop-filter: blur(8px);
  }

  .landing-fact-label {
    display: block;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--fg-soft);
  }

  .landing-fact-value {
    display: block;
    font-size: var(--step-2);
    font-weight: var(--text-strong);
    color: var(--fg);
    margin-block-start: var(--space-2xs);
  }

  .landing-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: center;
    margin-block-start: var(--space-s);
  }

  /* Highlights Cards */
  .landing-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
  }

  .landing-highlight-card {
    background-color: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-soft);
    padding: var(--space-l);
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    transition:
      translate var(--dur-fast) var(--ease-surface),
      border-color var(--dur-fast) var(--ease-surface);
  }

  @media (hover: hover) {
    .landing-highlight-card:hover {
      border-color: color-mix(in oklch, var(--fg) 30%, transparent);
    }

    /* The lift is motion: not under reduced motion nor in calm mode (no html.motion-ok). */
    :global(html.motion-ok) .landing-highlight-card:hover {
      translate: 0 -2px;
    }
  }

  .landing-card-icon {
    inline-size: var(--space-l);
    block-size: var(--space-l);
    border-radius: var(--radius-sharp);
    background-color: color-mix(in oklch, var(--action) 12%, transparent);
    color: var(--action);
    display: grid;
    place-items: center;
    margin-block-end: var(--space-2xs);
  }

  .landing-card-title {
    font-size: var(--step-0);
    font-weight: var(--text-strong);
  }

  .landing-card-text {
    font-size: var(--step--1);
    color: var(--fg-soft);
    line-height: var(--leading-body);
  }

  /* Steps List */
  .landing-steps-list {
    display: grid;
    gap: var(--space-m);
    max-width: 48rem;
    margin: var(--space-xl) auto 0;
  }

  .landing-step-row {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-m);
    align-items: start;
    padding: var(--space-m);
    background-color: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-soft);
  }

  .landing-step-num {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--accent-deco);
    line-height: 1;
    font-style: italic;
  }

  .landing-step-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    margin-block-end: var(--space-2xs);
  }

  .landing-step-title {
    font-size: var(--step-0);
    font-weight: var(--text-strong);
  }

  .landing-step-duration {
    font-size: var(--step--2);
    color: var(--fg-soft);
    font-family: var(--font-hud);
    font-variant-numeric: tabular-nums;
  }

  .landing-step-description {
    font-size: var(--step--1);
    color: var(--fg-soft);
    line-height: var(--leading-body);
    margin: 0;
  }

  /* FAQ */
  .landing-faq-grid {
    display: grid;
    gap: var(--space-s);
    max-width: 46rem;
    margin: var(--space-xl) auto 0;
  }

  .landing-faq-details {
    background-color: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-soft);
    padding: var(--space-m);
  }

  .landing-faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: var(--text-strong);
    cursor: pointer;
    list-style: none;
  }

  .landing-faq-question::-webkit-details-marker {
    display: none;
  }

  .landing-faq-question :global(.landing-faq-arrow) {
    flex: none;
    transition: rotate var(--dur-fast) var(--ease-surface);
  }

  .landing-faq-details[open] :global(.landing-faq-arrow) {
    rotate: 180deg;
  }

  .landing-faq-answer {
    margin-block-start: var(--space-s);
    color: var(--fg-soft);
    font-size: var(--step--1);
    line-height: var(--leading-body);
  }

  /* Contact Layout */
  .landing-contact-layout {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-xl);
  }

  @media (width >= 56rem) {
    .landing-contact-layout {
      grid-template-columns: 1fr 2fr;
    }
  }

  .landing-channels {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .landing-channels-title {
    font-size: var(--step-0);
    font-weight: var(--text-strong);
  }

  .landing-channels-list {
    display: grid;
    gap: var(--space-s);
  }

  .landing-channel-link {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    background-color: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-soft);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-fast) var(--ease-surface);
  }

  @media (hover: hover) {
    .landing-channel-link:hover {
      border-color: color-mix(in oklch, var(--fg) 30%, transparent);
    }
  }

  .landing-channel-label {
    font-size: var(--step--2);
    color: var(--fg-soft);
  }

  .landing-channel-value {
    font-weight: var(--text-strong);
    font-size: var(--step--1);
  }

  /* Descent Teaser */
  .landing-descent-teaser {
    padding-block: var(--space-3xl);
    background: linear-gradient(180deg, var(--c-abyss-raised) 0%, var(--c-abyss) 100%);
    border-block-start: 1px solid var(--line);
    text-align: center;
  }

  .landing-teaser-inner {
    max-width: 38rem;
    display: grid;
    gap: var(--space-m);
    justify-items: center;
  }

  .landing-teaser-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: var(--display-weight);
    line-height: var(--leading-snug);
  }

  .landing-teaser-lead {
    color: var(--fg-soft);
    font-size: var(--step-0);
    line-height: var(--leading-lead);
  }
</style>
